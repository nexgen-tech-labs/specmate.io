# Copy to .env and fill in local values. Never commit .env.

# Same Postgres instance used by apps/web (asyncpg driver)
# Uses 5434 locally by default to avoid clashing with other projects' Postgres on 5432 — adjust to match your docker run command.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5434/specmate"

# Claude API key (Anthropic) — used by the AI pipeline (Issue #4)
ANTHROPIC_API_KEY="sk-ant-..."

ENVIRONMENT="local"

# Azure Blob Storage — reads uploaded Source files for parsing (Issue #8).
# Same account apps/web writes to; local dev uses the Azurite emulator (see infra/README.md).
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="sources"

# Connector credentials (Issues #12-16) — single-tenant, ops-configured for now.
# Atlassian (shared by Jira + Confluence connectors): https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=""
ATLASSIAN_API_TOKEN=""
JIRA_BASE_URL=""
CONFLUENCE_BASE_URL=""
# Azure DevOps: PAT (Work Items Read/Write scope) or OAuth (Azure AD app registration,
# app-only client-credentials grant — see ado_auth.py docstring for the required Azure
# AD API permission + service-principal setup). If the three AZURE_AD_* vars are all
# set, OAuth is used instead of the PAT.
ADO_ORG_URL=""
ADO_PAT=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# GitHub token with repo read scope
GITHUB_TOKEN=""
# Slack bot token (xoxb-...) with channels:history scope
SLACK_BOT_TOKEN=""

# Default duplicate-detection similarity threshold, 0..1 (Issue 3.5). A workspace's
# duplicateThreshold column overrides this. Defaults to 0.55 if unset.
DUPLICATE_SIMILARITY_THRESHOLD="0.55"

# Stripe (Issue 10.9 — usage metering/reporting). Same TEST MODE secret key as
# apps/web's STRIPE_SECRET_KEY. STRIPE_USAGE_EVENT_NAME must match the
# event_name configured on the Stripe Meter used by the Starter overage Price
# (defaults to "published_item" if unset).
STRIPE_SECRET_KEY=""
STRIPE_USAGE_EVENT_NAME="published_item"
# Stripe Meter object ID (mtr_...) for the "published_item" meter — distinct from
# STRIPE_USAGE_EVENT_NAME (the event name string). Required for reconciliation
# readback (Issue 12.5); find it in the Stripe Dashboard under the meter's
# details page, or via `stripe billing_meters list`.
STRIPE_USAGE_METER_ID=""

# Max simultaneous Claude API calls the in-process scheduler allows (Issue 12.3).
# Defaults to 4 if unset.
MAX_CONCURRENT_AI_CALLS="4"

# Envelope encryption for per-workspace connector credentials (Issue #101).
# Production: URL of the Azure Key Vault holding the "connector-credentials-dek" secret
# (a base64-encoded 32-byte AES-256 key). Fetched once per process via DefaultAzureCredential
# and cached in memory — see app/services/crypto.py.
AZURE_KEY_VAULT_URL=""
# Local dev only: base64-encoded 32-byte key that bypasses Key Vault entirely when set.
# Generate one with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Never set this in production.
CONNECTOR_DEK_B64=""

# GitHub OAuth App (Issue #101) — for per-workspace delegated connector auth,
# distinct from GITHUB_TOKEN (the existing single-tenant PAT fallback) AND
# distinct from Issue #95's GITHUB_OAUTH_CLIENT_ID (that's for SpecMate USER
# LOGIN via GitHub — a completely different OAuth App registration/purpose).
GITHUB_OAUTH_APP_CLIENT_ID=""
GITHUB_OAUTH_APP_CLIENT_SECRET=""
# Base URL of the apps/web frontend (Issue #101) — the GitHub OAuth callback
# redirects here (into the connector setup wizard) once the token exchange
# completes. Also the one browser origin apps/api's CORS policy allows
# (app/main.py).
# Production: https://www.specmate.io. Defaults to the local Next.js dev server
# if unset (this was previously unset in the Bicep template in production —
# fixed; see infra/main.bicep's apiStaticEnvVars).
WEB_BASE_URL="http://localhost:3000"

# Atlassian OAuth App (fast-follow to Issue #101) — for per-workspace
# delegated Jira connector auth, distinct from ATLASSIAN_EMAIL/
# ATLASSIAN_API_TOKEN/JIRA_BASE_URL above (the existing single-tenant
# fallback, kept unchanged). Register at
# https://developer.atlassian.com/console/myapps/ with OAuth 2.0 (3LO),
# scopes read:jira-work + write:jira-work + offline_access.
JIRA_OAUTH_APP_CLIENT_ID=""
JIRA_OAUTH_APP_CLIENT_SECRET=""
# This API's own externally-reachable base URL — Atlassian calls this
# service's /connectors/jira/oauth/callback directly as the redirect_uri
# (unlike /oauth/start, which apps/web proxies server-side — see
# apps/web/src/lib/oauth-start-proxy.ts — the OAuth *callback* is invoked
# directly by Atlassian/GitHub, not proxied, so it needs a real public URL).
# specmate-api's Container App ingress was flipped from internal-only to
# external for this reason. Production: https://api.specmate.io. Defaults to
# the local uvicorn dev server if unset.
API_BASE_URL_EXTERNAL="http://localhost:8000"
